# ── Required — buyer must set these, no defaults ──────────────────────────
GCP_PROJECT_ID=
BQ_DATASET_ID=
GCS_BUCKET_NAME=

# ── Optional — sensible defaults in config.py ──────────────────────────────
GOOGLE_CLOUD_LOCATION=asia-south1
VERTEX_AI_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
QUERY_TIMEOUT_SEC=20
MAX_RESULT_ROWS=200
ENUM_CACHE_TTL_SEC=21600
MAX_WORKERS_CANDIDATES=10
MAX_WORKERS_QUESTIONS=5
SCREENING_TOP_K=30
SCREENING_TOP_N=5

# ── Feature-specific, required only if that feature is used ────────────────
EMAIL_API_URL=
TEST_EMAIL=
SENDER_EMAIL=
SENDER_PASSWORD=
MATCHMAKER_URL=
FRONTEND_URL=
HIRING_COMPANY=
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
RECRUITER_EMAIL=

# ── GCP auth — path to a mounted service-account key ────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=